<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description" content="The Barber Cut - Modern haircuts, beard styling and professional grooming.">

  <title>The Barber Cut | Barber Shop</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
      background: #0b0b0b;
      color: white;
      line-height: 1.6;
    }

    header {
      background: #000;
      padding: 18px 7%;
      position: sticky;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid #292929;
    }

    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      font-size: 21px;
      font-weight: bold;
      white-space: nowrap;
    }

    .logo span {
      color: #d4af37;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 12px;
      font-size: 13px;
    }

    nav a:hover {
      color: #d4af37;
    }

    .hero {
      min-height: 88vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 40px 20px;
      background:
        linear-gradient(rgba(0,0,0,.78), rgba(0,0,0,.92));
    }

    .hero-content {
      max-width: 700px;
    }

    .hero h1 {
      font-size: 52px;
      line-height: 1.1;
      margin-bottom: 18px;
    }

    .gold {
      color: #d4af37;
    }

    .hero p {
      color: #ccc;
      font-size: 18px;
      margin-bottom: 28px;
    }

    .button {
      display: inline-block;
      background: #d4af37;
      color: #000;
      text-decoration: none;
      padding: 13px 25px;
      border-radius: 6px;
      font-weight: bold;
    }

    section {
      padding: 70px 7%;
      text-align: center;
    }

    section h2 {
      font-size: 32px;
      margin-bottom: 35px;
    }

    .services {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 20px;
      max-width: 1000px;
      margin: auto;
    }

    .card {
      background: #171717;
      border: 1px solid #2c2c2c;
      border-radius: 12px;
      padding: 30px 20px;
    }

    .icon {
      font-size: 40px;
      margin-bottom: 15px;
    }

    .card h3 {
      color: #d4af37;
      margin-bottom: 10px;
    }

    .card p {
      color: #bbb;
    }

    .about {
      background: #151515;
    }

    .about p {
      max-width: 750px;
      margin: auto;
      color: #ccc;
      font-size: 17px;
    }

    .contact {
      background: #000;
    }

    .contact p {
      color: #ccc;
      margin: 8px 0;
    }

    footer {
      background: #000;
      border-top: 1px solid #292929;
      padding: 22px;
      text-align: center;
      color: #888;
      font-size: 14px;
    }

    @media (max-width: 650px) {
      nav {
        flex-direction: column;
      }

      nav a {
        margin: 0 5px;
      }

      .hero h1 {
        font-size: 38px;
      }

      .hero p {
        font-size: 16px;
      }
    }
  </style>
</head>

<body>

  <header>
    <nav>
      <div class="logo">
        THE <span>BARBER CUT</span>
      </div>

      <div>
        <a href="#home">Home</a>
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>
  </header>


  <section class="hero" id="home">
    <div class="hero-content">

      <h1>
        THE <span class="gold">BARBER CUT</span>
      </h1>

      <p>
        Premium haircuts, beard styling and professional grooming
        for a sharp and confident look.
      </p>

      <a href="#services" class="button">
        Explore Services
      </a>

    </div>
  </section>


  <section id="services">

    <h2>Our Services</h2>

    <div class="services">

      <div class="card">
        <div class="icon">✂️</div>
        <h3>Classic Haircut</h3>
        <p>
          Clean, stylish and professional haircut.
        </p>
      </div>

      <div class="card">
        <div class="icon">🧔</div>
        <h3>Beard Styling</h3>
        <p>
          Professional beard trimming and styling.
        </p>
      </div>

      <div class="card">
        <div class="icon">💈</div>
        <h3>Hair & Beard</h3>
        <p>
          Complete grooming for a fresh look.
        </p>
      </div>

      <div class="card">
        <div class="icon">✨</div>
        <h3>Premium Styling</h3>
        <p>
          Modern styling with professional finishing.
        </p>
      </div>

    </div>

  </section>


  <section class="about" id="about">

    <h2>About The Barber Cut</h2>

    <p>
      Welcome to The Barber Cut. We focus on modern styles,
      quality grooming and a comfortable barber shop experience.
      Our goal is simple — help you look sharp and feel confident.
    </p>

  </section>


  <section class="contact" id="contact">

    <h2>Visit The Barber Cut</h2>

    <p>📍 Your City, India</p>
    <p>🕐 Open Daily</p>

    <br>

    <a href="#home" class="button">
      Back To Top
    </a>

  </section>


  <footer>
    © 2026 The Barber Cut. All Rights Reserved.
  </footer>

</body>
</html>
